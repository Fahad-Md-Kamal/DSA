# Copy this to a local env file such as scripts/jira/jira.env, then source it:
#   source scripts/jira/jira.env
#
# Never commit the real token.

export JIRA_EMAIL="your-email@example.com"
export JIRA_API_TOKEN="your-scoped-api-token"

# Option A: set the Jira site and let scripts resolve the Cloud ID.
export JIRA_SITE="your-domain.atlassian.net"

# Option B: set the Cloud ID directly after running get-cloud-id.sh.
# export JIRA_CLOUD_ID="00000000-0000-0000-0000-000000000000"

# Optional: set this if you know the Jira custom field ID for "AI contribution".
# If omitted, scripts/jira.py will try to find the field by name.
# export AI_CONTRIBUTION_FIELD_ID="customfield_12345"

# Optional: set this if you know the Jira custom field ID for "%Done".
# If omitted, scripts/jira.py will try to find the field by name.
# export PERCENT_DONE_FIELD_ID="customfield_67890"
